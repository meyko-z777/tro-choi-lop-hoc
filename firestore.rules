rules_version = '2';
// Luật bảo vệ dữ liệu trò chơi (bản dùng MÃ PIN, không cần Google).
// PIN_HASH: mã băm SHA-256 của chuỗi 'gdct-tay-do:' + mã PIN. Claude gửi riêng mã này cho giảng viên, KHÔNG ghi vào kho công khai.
service cloud.firestore {
  match /databases/{db}/documents {
    // Giảng viên = máy đã nhập đúng PIN (có "chìa khóa" trong hostKeys)
    function isHost() {
      return request.auth != null && exists(/databases/$(db)/documents/hostKeys/$(request.auth.uid));
    }
    match /hostKeys/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin is string
        && hashing.sha256('gdct-tay-do:' + request.resource.data.pin).toHexString().lower() == 'PIN_HASH';
    }
    match /games/{g} {
      allow read: if true;                        // ai cũng xem được trạng thái ván (câu hỏi, kết quả)
      allow write: if isHost();
      // Sinh viên KHÔNG đăng nhập (Firebase giới hạn số tài khoản tạo mới trên cùng mạng).
      // Mỗi điện thoại tự sinh mã bí mật 20 ký tự (pid); bảng điểm công khai chỉ ghi theo SỐ THỨ TỰ, không lộ pid.
      match /players/{pid} {                      // sinh viên báo danh
        allow read, delete: if isHost();
        allow create: if pid.matches('^[A-Za-z0-9]{20}$')
          && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      }
      match /nums/{pid} {                         // số thứ tự do màn hình lớn cấp (ai biết pid mới đọc được)
        allow get: if true;
        allow list, write: if isHost();
      }
      match /answers/{id} {                       // mỗi máy nộp 1 lần mỗi câu; giờ nộp do máy chủ đóng dấu
        allow read, delete: if isHost();
        allow create: if request.resource.data.keys().hasOnly(['q', 'a', 'p', 't'])
          && request.resource.data.p is string && request.resource.data.p.matches('^[A-Za-z0-9]{20}$')
          && id == string(request.resource.data.q) + '_' + request.resource.data.p
          && request.resource.data.q is int && request.resource.data.a is int
          && request.resource.data.a >= 0 && request.resource.data.a < 6
          && request.resource.data.t == request.time;
      }
    }
  }
}
